rules_version = '2';

// Database: convertfile (and convertfile-backup). Clients only read their own documents;
// every write goes through Cloud Functions or the engine (Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
